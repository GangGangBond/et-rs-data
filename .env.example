# Compose reads this file. For native execution, export these values in your shell.
POSTGRES_PASSWORD=et_local_dev
POSTGRES_PORT=5433
DATABASE_URL=postgres://et:et_local_dev@127.0.0.1:5433/et_history
ET_DATA_BIND=127.0.0.1:8088
ET_DATA_TOKEN=
ET_DATA_RETENTION_DAYS=30
ET_DATA_BOOTSTRAP_MINUTES=60
COINGECKO_API_KEY=
# To expose the API on a server, set ET_DATA_HOST=0.0.0.0 and configure an API token.
# Hyperliquid collection is paused in the default build and compose deployment.
ET_HL_ENABLED=false
ET_HL_MAX_ADDRESSES=256
ET_HL_MIN_POSITION_USD=10000
